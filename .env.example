# ==============================================================================
# InsightFlow — Environment Configuration (.env.example)
# Build Battle 2026 | Frontend Arena Hackathon
# ==============================================================================

# Core Application Port & Host
VITE_PORT=5173
VITE_HOST=127.0.0.1

# Application Identity
VITE_APP_NAME="InsightFlow"
VITE_APP_TAGLINE="From Customer Voice to Business Action"

# Demo Mode & Local Engine Settings
# Set to 'true' to use the transparent local deterministic rule-based NLP engine
# (Complies with hackathon rule: never fabricate model responses or claim AI ran when it didn't)
VITE_ENABLE_LOCAL_ENGINE=true

# Optional: Adaption Labs Integration Keys
# If executing authenticated cloud jobs via Adaption platform API:
# ADAPTION_API_KEY=your_adaption_api_key_here
# ADAPTION_WORKSPACE_ID=your_adaption_workspace_id_here
# ADAPTION_APP_URL="https://adaptionlabs.ai/app"

# Optional: Supabase Persistence (Default uses persistent browser localStorage)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
